{
	"schemaVersion": 1,
	"id": "gearexpansion",
	"version": "${version}",
	"name": "Gear Expansion",
	"description": "Adds new tools, armor, and shields made from new ores, alloys, and fantasy materials.",
	"authors": [
		"Daniel"
	],
	"contact": {
		"sources": "https://github.com/Dynamic155/GearExpansion",
		"issues": "https://github.com/Dynamic155/GearExpansion/issues"
	},
	"license": "MIT",
	"icon": "assets/gearexpansion/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.gearexpansion.fabric.GearExpansionFabric"
		],
		"client": [
			"com.gearexpansion.fabric.client.GearExpansionFabricClient"
		],
		"fabric-datagen": [
			"com.gearexpansion.fabric.datagen.GearExpansionDataGenerator"
		],
		"fabric-client-gametest": [
			"com.gearexpansion.fabric.test.GearGameTest"
		],
		"modmenu": [
			"com.gearexpansion.fabric.client.GearExpansionModMenu"
		],
		"jei_mod_plugin": [
			"com.gearexpansion.compat.jei.GearJeiPlugin"
		],
		"rei_common": [
			"com.gearexpansion.compat.rei.GearReiCommonPlugin"
		],
		"rei_client": [
			"com.gearexpansion.compat.rei.GearReiClientPlugin"
		],
		"jade": [
			"com.gearexpansion.compat.jade.GearJadePlugin"
		]
	},
	"mixins": [
		"gearexpansion.mixins.json"
	],
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": ">=3.9.7",
		"jei": ">=31.8",
		"roughlyenoughitems": ">=26.3",
		"jade": ">=26.3.3",
		"modonomicon": ">=2.16.0"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"architectury": ">=22.0.3",
		"geckolib": ">=5.5.7"
	}
}
